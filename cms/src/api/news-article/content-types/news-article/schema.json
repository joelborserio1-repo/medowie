{
  "kind": "collectionType",
  "collectionName": "news_articles",
  "info": {
    "singularName": "news-article",
    "pluralName": "news-articles",
    "displayName": "News Article",
    "description": "Stallion announcements, race results, yearling sales and breeding news."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "excerpt": { "type": "text" },
    "body": { "type": "text" },
    "heroImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "category": {
      "type": "enumeration",
      "enum": ["Stallions", "Racing", "Progeny", "Breeding", "Yearlings", "Medowie Lodge"]
    },
    "publishedDate": { "type": "date" },
    "author": { "type": "string" },
    "relatedStallion": { "type": "relation", "relation": "manyToOne", "target": "api::stallion.stallion", "inversedBy": "newsArticles" },
    "relatedHorse": { "type": "relation", "relation": "manyToOne", "target": "api::horse-for-sale.horse-for-sale", "inversedBy": "newsArticles" },
    "state": { "type": "enumeration", "enum": ["draft", "published", "archived"], "default": "draft", "required": true },
    "metaTitle": { "type": "string" },
    "metaDescription": { "type": "text" }
  }
}
