{
  "kind": "collectionType",
  "collectionName": "stallions",
  "info": {
    "singularName": "stallion",
    "pluralName": "stallions",
    "displayName": "Stallion",
    "description": "Standardbred stallions standing at Medowie Lodge."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "countrySuffix": { "type": "string" },
    "state": {
      "type": "enumeration",
      "enum": ["draft", "admin_review", "published", "archived"],
      "default": "admin_review",
      "required": true
    },
    "featured": { "type": "boolean", "default": false },
    "displayOrder": { "type": "integer", "default": 0 },

    "gait": { "type": "enumeration", "enum": ["Pacer", "Trotter"] },
    "colour": { "type": "string" },
    "foaledDate": { "type": "date" },
    "height": { "type": "string" },

    "sire": { "type": "string" },
    "dam": { "type": "string" },
    "damsire": { "type": "string" },

    "serviceFee": { "type": "decimal" },
    "feeNotes": { "type": "text" },
    "includesGst": { "type": "boolean", "default": true },

    "mileRate": { "type": "string" },
    "careerEarnings": { "type": "decimal" },
    "starts": { "type": "integer" },
    "wins": { "type": "integer" },
    "seconds": { "type": "integer" },
    "thirds": { "type": "integer" },

    "headline": { "type": "string" },
    "shortDescription": { "type": "text" },
    "fullBiography": { "type": "text" },

    "semenChilledAu": { "type": "boolean", "default": false },
    "semenFrozenAu": { "type": "boolean", "default": false },
    "semenFrozenNz": { "type": "boolean", "default": false },
    "semenNotes": { "type": "text" },

    "matingInformation": { "type": "text" },
    "matingPdf": { "type": "media", "multiple": false, "allowedTypes": ["files"] },
    "pedigreeDocument": { "type": "media", "multiple": false, "allowedTypes": ["files"] },

    "heroImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "profileImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "cardImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "gallery": { "type": "media", "multiple": true, "allowedTypes": ["images"] },
    "documents": { "type": "media", "multiple": true, "allowedTypes": ["files"] },

    "metaTitle": { "type": "string" },
    "metaDescription": { "type": "text" },

    "highlights": { "type": "component", "component": "stallion.highlight", "repeatable": true },
    "eligibility": { "type": "component", "component": "stallion.eligibility", "repeatable": true },
    "progeny": { "type": "component", "component": "stallion.progeny", "repeatable": true },
    "pedigree": { "type": "component", "component": "stallion.pedigree", "repeatable": false },
    "videos": { "type": "component", "component": "stallion.video", "repeatable": true },

    "newsArticles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::news-article.news-article",
      "mappedBy": "relatedStallion"
    },
    "documentsResources": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::form-document.form-document",
      "mappedBy": "stallion"
    }
  }
}
