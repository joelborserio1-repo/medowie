HOST=0.0.0.0
PORT=1337

# Generate real values with: openssl rand -base64 32 (repeat for each APP_KEYS entry)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database — sqlite for local dev; postgres in production (Railway injects
# DATABASE_URL automatically when you add its Postgres plugin).
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@host:5432/railway
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Cloudflare R2 media storage (optional). Unset = local disk storage, which
# is fine for local dev but NOT for Railway production (ephemeral filesystem).
# R2_ACCOUNT_ID=
# R2_BUCKET=medowie-lodge-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://media.medowielodge.com.au

# Local/dev only — auto-creates the first admin on boot. Never set in production.
# STRAPI_ADMIN_EMAIL=admin@example.com
# STRAPI_ADMIN_PASSWORD=ChangeMe123!
