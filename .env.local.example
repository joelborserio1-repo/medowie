# Supabase project — see docs/SUPABASE_SETUP.md to create one and run the
# migrations. Both are required; the anon key is safe to expose to the
# client, Row Level Security is what actually restricts access.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses Row Level Security entirely. Only needed for
# scripts run outside the app (e.g. scripts/upload-seed-assets.mjs). Never
# expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL — used for metadata, OpenGraph, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — enables transactional email via Resend. Enquiries still save
# to Supabase without it.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Medowie Lodge <enquiries@medowielodge.com.au>"
