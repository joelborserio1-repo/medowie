# Strapi CMS URL. Server-only reads use STRAPI_URL; NEXT_PUBLIC_STRAPI_URL is
# also needed because a couple of components resolve media URLs client-side.
# Keep both pointed at the same place.
STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Strapi API token (optional locally — required in production once the
# Public role's permissions are locked down further, or for any Next.js
# read that needs elevated access). Create one in Strapi admin under
# Settings → API Tokens.
STRAPI_API_TOKEN=

# Canonical site URL — used for metadata, OpenGraph, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — enables transactional email via Resend. Enquiries still save
# to Strapi without it.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Medowie Lodge <enquiries@medowielodge.com.au>"
